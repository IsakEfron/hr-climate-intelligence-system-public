#         CONFIGURACIÓN DE CANELS - Sistema de Encuestas          
#                                                                 
#   Este archivo contiene la configuración del sistema.           
#   NO COMPARTAS ESTE ARCHIVO en repositorios públicos.          
#   Contiene credenciales sensibles.                             
# 

# =================================================================
#   CONFIGURACIÓN DE BASE DE DATOS
# =================================================================

# Host donde está instalado MySQL
# Ejemplos:
#   - localhost      (misma máquina)
#   - 192.168.1.100  (otra máquina en la red)
#   - mysql.example.com (servidor remoto)
DB_HOST=localhost

# Usuario de acceso a MySQL
# Por defecto es 'root', pero puedes crear uno específico
DB_USER=root

# Contraseña del usuario
# SEGURIDAD: Cámbiala a algo fuerte en producción
# Buenas prácticas: 
#   - Usa una contraseña larga (12+ caracteres)
#   - Combina mayúsculas, minúsculas, números y símbolos
# Esta contraseña es crítica para la seguridad de tu base de datos, así que asegúrate de cambiarla antes de usar en producción.
DB_PASSWORD=tu_password_aqui

# Nombre de la base de datos
# Se recomienda usar canels_db o similar
DB_NAME=canels_db

# =================================================================
# CONFIGURACIÓN DE SEGURIDAD FLASK
# =================================================================

# Clave secreta para sesiones y tokens
# IMPORTANTE: Usa una cadena aleatoria y fuerte
# Puedes generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ejemplo (NO USES ESTE):}
# Sirve para proteger las sesiones de usuario y otros datos sensibles. Cambia esto a algo único para tu aplicación.
SECRET_KEY=tu-clave-secreta-super-segura-aqui-cambiala

# =================================================================
#  CONFIGURACIÓN DE MYSQL (RUTAS DEL BINARIO)
# =================================================================

# En Windows:
# La ruta a los binarios de MySQL (mysqldump, mysql)
# Busca la carpeta donde instalaste MySQL y ve a \bin
# Típicamente:
#   - C:\Program Files\MySQL\MySQL Server 8.0\bin
#   - C:\Program Files\MySQL\MySQL Server 5.7\bin
#   - C:\xampp\mysql\bin (si usas XAMPP)
MYSQL_BIN_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin"

# En Linux:
# MYSQL_BIN_PATH=/usr/bin
# O:
# MYSQL_BIN_PATH=/usr/local/bin

# En macOS:
# MYSQL_BIN_PATH=/usr/local/mysql/bin

# =================================================================
#  CONFIGURACIÓN DE ADMINISTRADOR
# =================================================================

# Token/Clave para crear nuevos usuarios en el registro
# Esta clave es necesaria para que cualquiera pueda registrarse
# SEGURIDAD: Cámbiala a algo único y secreto
# El primer usuario debe usar esta clave
MASTER_KEY=CanelsMaster2026

# =================================================================
#  CONFIGURACIÓN DE SERVIDOR
# =================================================================

# Host donde escucha el servidor
# Opciones:
#   - 127.0.0.1 o localhost  (solo tu máquina)
#   - 0.0.0.0               (todas las interfaces - RED LOCAL)
#   - 192.168.1.100         (solo esa IP)
# Para acceso desde red local, usa: 0.0.0.0
SERVER_HOST=0.0.0.0

# Puerto donde escucha el servidor
# Valores comunes: 5000, 8000, 8080, 3000
# NOTA: Puertos menores a 1024 requieren privilegios de admin
SERVER_PORT=5000

# Modo debug (True en desarrollo, False en producción)
# En modo debug:
#    El servidor se reinicia al cambiar archivos
#    Se muestran errores detallados
#    NO ES SEGURO para producción
DEBUG_MODE=True

# =================================================================
#  CONFIGURACIÓN DE APLICACIÓN
# =================================================================

# Tamaño máximo de archivo a subir (en MB)
MAX_UPLOAD_SIZE=50

# Timezone para logs y timestamps
TIMEZONE=America/Mexico_City

# Modo de registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =================================================================
#  CONFIGURACIÓN AVANZADA (Opcional)
# =================================================================

# Habilitar HTTPS (requiere certificado)
# USE_HTTPS=False
# SSL_CERT=path/to/cert.pem
# SSL_KEY=path/to/key.pem

# =================================================================
#  NOTAS IMPORTANTES
# =================================================================

# 1. PRIMEROS PASOS:
#    - Copia este archivo de .env.example a .env
#    - Reemplaza los valores con los correctos para tu entorno
#    - NO COMPARTAS el archivo .env en GitHub o redes

# 2. SEGURIDAD EN PRODUCCIÓN:
#    - Cambia SECRET_KEY a algo único y fuerte
#    - Cambia MASTER_KEY a algo único
#    - Cambia DB_PASSWORD a una contraseña fuerte
#    - Pon DEBUG_MODE=False
#    - Usa HTTPS
#    - Ejecuta con un servidor WSGI (Gunicorn, uWSGI)

# 3. PARA CAMBIAR PUERTO:
#    - Si 5000 está ocupado, usa otro (8000, 8080, 3000, etc)
#    - O ejecuta: python app.py --port 8000

# 4. PARA ACCESO EN RED LOCAL:
#    - Asegúrate que SERVER_HOST=0.0.0.0
#    - Abre el puerto en el firewall
#    - Los usuarios acceden con: http://<tu-ip>:5000

# 5. ENCONTRAR TU IP:
#    Windows: ipconfig → IPv4 Address
#    Linux/Mac: ifconfig → inet

# =================================================================
